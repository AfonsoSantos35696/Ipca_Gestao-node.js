<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consultar Estado</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; }
        .table-custom { background: white; border-radius: 1rem; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="container mt-5">
        <h2 class="mb-4"><i class="bi bi-search me-2"></i>Consultar Estado dos Pedidos</h2>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-file-person me-2"></i>Ficha de Aluno</h5>
            </div>
            <div class="card-body">
                <% if (fichas.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover table-custom">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Data Submissão</th>
                                    <th>Estado</th>
                                    <th>Observações</th>
                                    <th>Validado por</th>
                                    <th>Data Validação</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% fichas.forEach(f => { %>
                                <tr>
                                    <td><%= f._id.toString().substring(18) %></td>
                                    <td><%= f.data_submissao ? new Date(f.data_submissao).toLocaleString('pt-PT') : '-' %></td>
                                    <td>
                                        <span class="badge bg-<%= f.estado === 'aprovada' ? 'success' : (f.estado === 'rejeitada' ? 'danger' : 'warning') %>">
                                            <%= f.estado %>
                                        </span>
                                    </td>
                                    <td><%= f.observacoes_gestor || '-' %></td>
                                    <td><%= f.id_gestor || '-' %></td>
                                    <td><%= f.data_validacao ? new Date(f.data_validacao).toLocaleString('pt-PT') : '-' %></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p class="text-muted">Ainda não preencheu a ficha.</p>
                <% } %>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-warning text-white">
                <h5 class="mb-0"><i class="bi bi-envelope-paper me-2"></i>Pedidos de Matrícula</h5>
            </div>
            <div class="card-body">
                <% if (pedidos.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover table-custom">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Curso</th>
                                    <th>Data Pedido</th>
                                    <th>Estado</th>
                                    <th>Observações</th>
                                    <th>Funcionário</th>
                                    <th>Data Decisão</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% pedidos.forEach(p => { %>
                                <tr>
                                    <td><%= p._id.toString().substring(18) %></td>
                                    <td><%= p.id_curso ? p.id_curso.nome_cursos : 'N/A' %></td>
                                    <td><%= new Date(p.data_pedido).toLocaleString('pt-PT') %></td>
                                    <td>
                                        <span class="badge bg-<%= p.estado === 'aprovado' ? 'success' : (p.estado === 'rejeitado' ? 'danger' : 'warning') %>">
                                            <%= p.estado %>
                                        </span>
                                    </td>
                                    <td><%= p.observacoes || '-' %></td>
                                    <td><%= p.id_funcionario ? p.id_funcionario.nome : '-' %></td>
                                    <td><%= p.data_decisao ? new Date(p.data_decisao).toLocaleString('pt-PT') : '-' %></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p class="text-muted">Ainda não fez nenhum pedido de matrícula.</p>
                <% } %>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>