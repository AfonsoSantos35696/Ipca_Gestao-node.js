<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pautas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>body{background:#f8f9fa;}</style>
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2><i class="bi bi-table me-2"></i>Pautas</h2>
        <p class="text-muted">Criar e consultar pautas de avaliação.</p>
      </div>
    </div>
    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>
    <div class="card mb-4">
      <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Criar nova pauta</h5>
      </div>
      <div class="card-body">
        <form action="/funcionario/pautas/create" method="post" class="row g-3">
          <div class="col-md-4">
            <label class="form-label" for="id_disciplina">Disciplina</label>
            <select class="form-select" id="id_disciplina" name="id_disciplina" required>
              <option value="">Selecione...</option>
              <% disciplinas.forEach(d => { %>
                <option value="<%= d._id %>"><%= d.nome_disciplina %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="ano_letivo">Ano Letivo</label>
            <input type="text" class="form-control" id="ano_letivo" name="ano_letivo" placeholder="2024/2025" required>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="epoca">Época</label>
            <input type="text" class="form-control" id="epoca" name="epoca" placeholder="Normal" required>
          </div>
          <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-success">Criar</button>
          </div>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Pautas existentes</h5>
      </div>
      <div class="card-body table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>ID</th>
              <th>Disciplina</th>
              <th>Ano</th>
              <th>Época</th>
              <th>Criada</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% pautas.forEach(p => { %>
              <tr>
                <td><%= p._id %></td>
                <td><%= p.id_disciplina?.nome_disciplina || 'Sem disciplina' %></td>
                <td><%= p.ano_letivo %></td>
                <td><%= p.epoca %></td>
                <td><%= p.data_criacao ? new Date(p.data_criacao).toLocaleString('pt-PT') : '-' %></td>
                <td class="text-nowrap">
                  <a href="/funcionario/pautas/lancar/<%= p._id %>" class="btn btn-sm btn-primary">Lançar Notas</a>
                  <a href="/funcionario/pautas/ver/<%= p._id %>" class="btn btn-sm btn-info">Ver</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
