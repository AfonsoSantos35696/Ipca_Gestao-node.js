<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pedidos de Matrícula</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>body{background:#f8f9fa;}</style>
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container mt-5">
    <h2 class="mb-4"><i class="bi bi-envelope-paper me-2"></i>Pedidos de Matrícula</h2>
    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>
    <div class="row gy-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header bg-warning text-white">
            <h5 class="mb-0">Pendentes (<%= pendentes.length %>)</h5>
          </div>
          <div class="card-body">
            <% if (pendentes.length === 0) { %>
              <p class="text-muted">Nenhum pedido pendente.</p>
            <% } else { %>
              <% pendentes.forEach(p => { %>
                <div class="card mb-3">
                  <div class="card-body">
                    <div class="row align-items-center">
                      <div class="col-md-8">
                        <h6><i class="bi bi-person-circle me-1"></i><%= p.id_aluno?.nome || 'Aluno' %></h6>
                        <p class="mb-1"><strong>Curso:</strong> <%= p.id_curso?.nome_cursos || '-' %></p>
                        <small class="text-muted">Data do pedido: <%= p.data_pedido ? new Date(p.data_pedido).toLocaleString('pt-PT') : '-' %></small>
                      </div>
                      <div class="col-md-4 text-end">
                        <form action="/funcionario/pedidos_matricula/decide" method="post" class="d-flex justify-content-end gap-2 flex-wrap">
                          <input type="hidden" name="id_pedido" value="<%= p._id %>">
                          <input type="text" class="form-control form-control-sm" name="observacoes" placeholder="Observações" style="max-width:200px;">
                          <button type="submit" name="acao" value="aprovado" class="btn btn-success btn-sm">Aprovar</button>
                          <button type="submit" name="acao" value="rejeitado" class="btn btn-danger btn-sm">Rejeitar</button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>
      <div class="col-12">
        <div class="card">
          <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Histórico</h5>
          </div>
          <div class="card-body">
            <% if (outros.length === 0) { %>
              <p class="text-muted">Nenhum pedido processado.</p>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead>
                    <tr>
                      <th>Aluno</th>
                      <th>Curso</th>
                      <th>Data Pedido</th>
                      <th>Estado</th>
                      <th>Observações</th>
                      <th>Funcionário</th>
                      <th>Data Decisão</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% outros.forEach(p => { %>
                      <tr>
                        <td><%= p.id_aluno?.nome || 'Aluno' %></td>
                        <td><%= p.id_curso?.nome_cursos || '-' %></td>
                        <td><%= p.data_pedido ? new Date(p.data_pedido).toLocaleString('pt-PT') : '-' %></td>
                        <td><span class="badge bg-<%= p.estado === 'aprovado' ? 'success' : 'danger' %>"><%= p.estado %></span></td>
                        <td><%= p.observacoes || '-' %></td>
                        <td><%= p.id_funcionario || '-' %></td>
                        <td><%= p.data_decisao ? new Date(p.data_decisao).toLocaleString('pt-PT') : '-' %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
