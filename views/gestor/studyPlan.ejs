<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Plano de Estudos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>body{background:#f8f9fa;}</style>
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container mt-5">
    <h2 class="mb-4"><i class="bi bi-diagram-3 me-2"></i>Plano de Estudos</h2>
    <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <div class="card mb-4">
      <div class="card-header bg-primary text-white"><h5 class="mb-0">Adicionar Associação Curso-Disciplina</h5></div>
      <div class="card-body">
        <form action="/gestor/plano_estudos/add" method="post" class="row g-3">
          <div class="col-md-3"><label class="form-label" for="curso">Curso</label><select id="curso" name="curso" class="form-select" required><option value="">Selecione...</option><% cursos.forEach(c => { %><option value="<%= c._id %>" data-disciplinas="<%= JSON.stringify(c.disciplinas ? c.disciplinas.map(d => ({ id: d._id, nome: d.nome_disciplina })) : []) %>"><%= c.nome_cursos %></option><% }) %></select></div>
          <div class="col-md-3"><label class="form-label" for="disciplina">Disciplina</label><select id="disciplina" name="disciplina" class="form-select" required><option value="">Selecione um curso primeiro...</option></select></div>
          <div class="col-md-2"><label class="form-label" for="ano">Ano</label><input type="number" id="ano" name="ano" class="form-control" min="1" value="2026" required></div>
          <div class="col-md-2"><label class="form-label" for="semestre">Semestre</label><select id="semestre" name="semestre" class="form-select" required><option value="1">1º Semestre</option><option value="2">2º Semestre</option></select></div>
          <div class="col-md-2 d-grid"><button type="submit" class="btn btn-success">Adicionar</button></div>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card-header bg-secondary text-white"><h5 class="mb-0">Associações Atuais</h5></div>
      <div class="card-body table-responsive">
        <table class="table table-hover">
          <thead><tr><th>Curso</th><th>Disciplina</th><th>Ano</th><th>Semestre</th><th>Ações</th></tr></thead>
          <tbody>
            <% planos.forEach(p => { %>
              <tr>
                <td><%= p.course?.nome_cursos || 'Curso' %></td>
                <td><%= p.discipline?.nome_disciplina || 'Disciplina' %></td>
                <td><%= p.ano %></td>
                <td><%= p.semestre %></td>
                <td><a href="/gestor/plano_estudos/remove/<%= p._id %>" class="btn btn-sm btn-danger" onclick="return confirm('Remover esta associação?')">Remover</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <script>
    // Filtrar disciplinas por curso
    document.getElementById('curso').addEventListener('change', function() {
      const cursoSelect = this;
      const disciplinaSelect = document.getElementById('disciplina');
      
      if (!this.value) {
        disciplinaSelect.innerHTML = '<option value="">Selecione um curso primeiro...</option>';
        return;
      }
      
      const selectedOption = cursoSelect.selectedOptions[0];
      let disciplinas = [];
      
      try {
        const dataAttr = selectedOption.getAttribute('data-disciplinas');
        if (dataAttr) {
          disciplinas = JSON.parse(dataAttr);
        }
      } catch (e) {
        console.error('Erro ao fazer parse das disciplinas:', e);
      }
      
      if (disciplinas.length === 0) {
        disciplinaSelect.innerHTML = '<option value="">Nenhuma disciplina associada</option>';
        return;
      }
      
      // Construir opções
      let html = '<option value="">Selecione...</option>';
      disciplinas.forEach(d => {
        html += `<option value="${d.id}">${d.nome}</option>`;
      });
      disciplinaSelect.innerHTML = html;
    });
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
